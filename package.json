{
  "name": "my-pwa-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "phone": "node scripts/phone.mjs",
    "phone:preview": "npm run build && node scripts/phone.mjs --preview",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "cloudflared": "^0.7.3",
    "eruda": "^3.4.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
